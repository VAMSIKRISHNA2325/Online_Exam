+﻿:root {
+  --bg:#f3f4f6;
+  --surface:#fff;
+  --ink:#1f2937;
+  --muted:#667085;
+  --line:#dce1e7;
+  --primary:#2563eb;
+  --danger:#b42318;
+  --success:#237447;
+  font-family:'Segoe UI',system-ui,sans-serif;
+  color:var(--ink);
+  background:var(--bg);
+  font-size:14px;
+  line-height:1.5
+}
+
+* {
+  box-sizing:border-box
+}
+
+html {
+  min-width:320px
+}
+
+body {
+  margin:0;
+  min-height:100vh
+}
+
+button,input,textarea {
+  font:inherit
+}
+
+button {
+  cursor:pointer
+}
+
+a {
+  color:var(--primary);
+  text-decoration:none
+}
+
+a:hover {
+  text-decoration:underline
+}
+
+h1,h2,h3,p {
+  margin-top:0
+}
+
+h1 {
+  font-size:26px;
+  line-height:1.3;
+  font-weight:600
+}
+
+h2 {
+  font-size:19px;
+  line-height:1.4;
+  font-weight:600
+}
+
+h3 {
+  font-size:16px;
+  line-height:1.4;
+  font-weight:600
+}
+
+[hidden] {
+  display:none!important
+}
+
+:focus-visible {
+  outline:3px solid #93b4fb;
+  outline-offset:3px
+}
+
+.sr-only {
+  position:absolute!important;
+  width:1px;
+  height:1px;
+  padding:0;
+  margin:-1px;
+  overflow:hidden;
+  clip:rect(0,0,0,0);
+  white-space:nowrap;
+  border:0
+}
+
+.app-frame {
+  min-height:100vh;
+  display:flex;
+  flex-direction:column
+}
+
+.app-header,.exam-header {
+  display:flex;
+  align-items:center;
+  gap:32px;
+  min-height:64px;
+  padding:12px 28px;
+  background:var(--surface);
+  border-bottom:1px solid var(--line)
+}
+
+.wordmark {
+  display:inline-flex;
+  align-items:center;
+  gap:10px;
+  color:var(--ink);
+  font-size:18px;
+  font-weight:600;
+  white-space:nowrap
+}
+
+.wordmark:hover {
+  text-decoration:none
+}
+
+.wordmark-icon {
+  display:inline-grid;
+  place-items:center;
+  width:32px;
+  height:32px;
+  border-radius:5px;
+  color:#fff;
+  background:var(--primary);
+  font-size:18px;
+  font-weight:600
+}
+
+.header-nav {
+  display:flex;
+  align-items:center;
+  flex-wrap:wrap;
+  gap:6px
+}
+
+.header-nav a {
+  padding:8px 12px;
+  border-radius:4px;
+  color:#475467;
+  font-weight:500
+}
+
+.header-nav a:hover {
+  background:#f4f6f9;
+  text-decoration:none
+}
+
+.header-nav a[aria-current=page] {
+  color:var(--primary);
+  background:#eff4ff
+}
+
+.header-right {
+  display:flex;
+  align-items:center;
+  gap:16px;
+  margin-left:auto
+}
+
+.header-label,.exam-header-label {
+  color:var(--muted);
+  font-size:13px
+}
+
+.app-footer {
+  display:flex;
+  justify-content:space-between;
+  gap:16px;
+  margin-top:auto;
+  padding:18px 28px;
+  color:var(--muted);
+  border-top:1px solid var(--line);
+  font-size:12px
+}
+
+.primary-button,.outline-button,.sidebar-new {
+  display:inline-flex;
+  align-items:center;
+  justify-content:center;
+  gap:8px;
+  min-height:40px;
+  padding:9px 16px;
+  border:1px solid transparent;
+  border-radius:5px;
+  font-size:14px;
+  font-weight:500;
+  line-height:1.4;
+  text-align:center;
+  text-decoration:none
+}
+
+.primary-button,.sidebar-new {
+  background:var(--primary);
+  color:#fff
+}
+
+.primary-button:hover,.sidebar-new:hover {
+  background:#1d4ed8;
+  text-decoration:none
+}
+
+.outline-button {
+  border-color:#cdd4df;
+  background:#fff;
+  color:#344054
+}
+
+.outline-button:hover {
+  border-color:#a9b8cf;
+  background:#f8fafc;
+  text-decoration:none
+}
+
+button:disabled,.primary-button:disabled,.outline-button:disabled {
+  opacity:.55;
+  cursor:not-allowed
+}
+
+.text-button-inline,.danger-link,.question-actions button {
+  padding:5px 0;
+  border:0;
+  background:transparent;
+  color:var(--primary);
+  font-size:13px;
+  font-weight:500
+}
+
+.text-button-inline:hover,.danger-link:hover,.question-actions button:hover {
+  text-decoration:underline
+}
+
+.danger-link,.question-actions button:last-child {
+  color:var(--danger)
+}
+
+.notice {
+  margin:16px 0;
+  padding:12px 16px;
+  border:1px solid #f1c9c4;
+  border-radius:5px;
+  background:#fef3f2;
+  color:var(--danger);
+  font-size:14px;
+  overflow-wrap:anywhere
+}
+
+.desk-status {
+  margin:16px 0;
+  padding:12px 16px;
+  border:1px solid #bcdfcd;
+  border-radius:5px;
+  color:var(--success);
+  background:#effaf4
+}
+
+.loading-state {
+  padding:24px 0;
+  color:var(--muted)
+}
+
+.section-number {
+  margin:0 0 6px;
+  color:var(--muted);
+  font-size:12px;
+  font-weight:500
+}
+
+.page-heading {
+  margin-bottom:24px
+}
+
+.page-heading h1 {
+  margin-bottom:6px
+}
+
+.page-heading p,.home-subtitle {
+  margin:0;
+  color:var(--muted)
+}
+
+.home-main,.student-main {
+  width:min(1200px,calc(100% - 48px));
+  margin:0 auto;
+  padding:28px 0 40px;
+  flex:1
+}
+
+.dashboard-panel,.account-item,.catalog-section {
+  border:1px solid var(--line);
+  border-radius:6px;
+  background:var(--surface)
+}
+
+.account-grid {
+  display:grid;
+  grid-template-columns:repeat(3,minmax(0,1fr));
+  gap:20px;
+  margin-bottom:24px
+}
+
+.account-item {
+  display:flex;
+  flex-direction:column;
+  gap:10px;
+  padding:20px;
+  min-width:0
+}
+
+.account-item span {
+  color:var(--muted);
+  font-size:13px
+}
+
+.account-item strong {
+  font-size:19px;
+  font-weight:600;
+  overflow-wrap:anywhere
+}
+
+.dashboard-panel {
+  padding:24px
+}
+
+.dashboard-panel h2 {
+  margin-bottom:8px
+}
+
+.dashboard-panel p {
+  margin-bottom:20px;
+  color:var(--muted)
+}
+
+.workspace-link {
+  width:auto
+}
+
+.login-shell {
